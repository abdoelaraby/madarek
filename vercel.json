{
  "cleanUrls": true,
  "headers": [
    { "source": "/videos/(.*)\\.ts", "headers": [ { "key": "Content-Type", "value": "video/mp2t" }, { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/videos/(.*)\\.m3u8", "headers": [ { "key": "Content-Type", "value": "application/vnd.apple.mpegurl" }, { "key": "Cache-Control", "value": "public, max-age=3600" } ] },
    { "source": "/videos/(.*)\\.mp4", "headers": [ { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" } ] },
    { "source": "/(assets|fonts|vendor)/(.*)", "headers": [ { "key": "Cache-Control", "value": "public, max-age=604800" } ] },
    { "source": "/(.*)", "headers": [ { "key": "X-Content-Type-Options", "value": "nosniff" }, { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" } ] }
  ]
}
